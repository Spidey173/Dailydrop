# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# PostgreSQL Database Connection String
# Replace with your PostgreSQL connection URL
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_MIN_CONN=1
DB_MAX_CONN=10
DB_TIMEOUT=30

# Redis Cache, Task Queue & Distributed Lock
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# Security (Required: Generate a strong, unique 32-byte / 64-char hex secret key)
# Run in terminal: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_and_paste_a_secure_random_hex_key_here

# Application Settings
ITEMS_PER_PAGE=12
ORDERS_PER_PAGE=10

# Razorpay Payment Gateway (Test Mode / Sandbox)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
