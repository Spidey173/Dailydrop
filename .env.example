# ==============================================================================
# DailyDrop Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or set these variables
# in your hosting provider (Vercel Project Settings, Docker environment, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask & Core Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: 'production', 'development', or 'testing'
FLASK_ENV=development

# Enable or disable debug mode (default: True in development, False in production)
FLASK_DEBUG=True

# Server port for local execution (default: 5000)
PORT=5000

# ------------------------------------------------------------------------------
# 2. Security & Session Management (CRITICAL)
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing of session cookies and CSRF tokens.
# Production strictly requires a strong, unique 32-byte / 64-character hex key.
# Generate in terminal: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_and_paste_a_secure_random_hex_key_here

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection (Neon / Local / Docker)
# ------------------------------------------------------------------------------
# PostgreSQL connection URL (Neon pooled connection string recommended for production)
# Example: postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/dailydrop

# Connection pool boundaries (serverless defaults: min=1, max=3; local defaults: min=3, max=15)
DB_MIN_CONN=3
DB_MAX_CONN=15
DB_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. Redis Cache, Distributed Locks & Task Queue (Upstash / Local / Docker)
# ------------------------------------------------------------------------------
# Redis connection URL. For Upstash, use 'rediss://default:token@host:port'.
# If Redis is unavailable or unconfigured, DailyDrop automatically falls back
# to thread-safe in-memory caching and reservations.
REDIS_URL=redis://127.0.0.1:6379/0

# Toggle Redis integration (default: true; set to false to force in-memory fallback)
REDIS_ENABLED=true

# Redis network socket timeout in seconds (default: 0.5)
REDIS_SOCKET_TIMEOUT=0.5

# Time-to-live for cached catalog queries in seconds (default: 600 / 10 minutes)
CACHE_CATALOG_TTL=600

# Time-to-live for checkout idempotency tokens in seconds (default: 86400 / 24 hours)
IDEMPOTENCY_TTL=86400

# Optional storage URI for Flask-Limiter rate limiting (defaults to Redis if available, else memory://)
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 5. File Uploads & Serverless Filesystem Protection
# ------------------------------------------------------------------------------
# Local folder for image uploads
UPLOAD_FOLDER=static/uploads

# Disable filesystem file uploads (set to true on Vercel serverless read-only filesystem)
DISABLE_FILE_UPLOADS=false

# ------------------------------------------------------------------------------
# 6. Razorpay Payment Gateway (Test Mode / Production)
# ------------------------------------------------------------------------------
# Razorpay API Credentials obtained from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret for validating HMAC-SHA256 signatures on incoming webhook events
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Allow modal-dismissal simulated verification in demo environments
# (CRITICAL: Strictly false in production for real payment verification)
DEMO_PAYMENTS=false

# ------------------------------------------------------------------------------
# 7. CI & Testing Environment Flags
# ------------------------------------------------------------------------------
# Set to 'true' in CI to execute concurrency race tests against a live PostgreSQL service
# TEST_USE_REAL_POSTGRES=false
